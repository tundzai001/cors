# Copy to .env on the server and fill real values there.
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
MQTT_USERNAME=CHANGE_ME
MQTT_PASSWORD=CHANGE_ME

CASTER_HOST=example.com
CASTER_PORT=2101
CASTER_ADMIN_USER=CHANGE_ME
CASTER_PASSWORD=CHANGE_ME

# Required shared secret for external NTRIP wake/stop control callbacks (32+ chars).
NTRIP_CONTROL_TOKEN=CHANGE_ME_GENERATE_URLSAFE_RANDOM_32_CHARS_OR_MORE

# Set only the reverse-proxy IPs/CIDRs that are allowed to supply X-Forwarded-For.
TRUSTED_PROXY_IPS=127.0.0.1/32,::1/128

# Save the first valid position point immediately, then repeat at this interval.
ROVER_FIXED_POINT_INTERVAL_SECONDS=120

# Zalo Bot API (direct chats)
ENABLE_ZALO_BOT=false
ZALO_BOT_TOKEN=CHANGE_ME
ZALO_ADMIN_GROUP_TOKEN=CHANGE_ME
ZALO_PUBLIC_GROUP_TOKEN=CHANGE_ME
ZALO_BOT_ADMIN_USERNAME=admin
ENABLE_ZALO_ERROR_ALERTS=true
# Optional absolute path; leave empty to use backend/zalo_chats.json
ZALO_CHATS_FILE=
# Optional absolute path; leave empty to use backend/zalo_groups.json
ZALO_GROUPS_FILE=

DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@localhost:5432/cors_db
AUTH_DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@localhost:5432/auth_db

APP_ENV=production
APP_VERSION=V2.3.1
ENFORCE_AGENT_AUTH=true
SECRET_KEY=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_BASE64_48
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# === Zalo Bot ===
ENABLE_ZALO_BOT=false
ZALO_BOT_MODE=polling
ZALO_BOT_TOKEN=CHANGE_ME
ZALO_WEBHOOK_URL=https://cors.aitogy.com/api/zalo/webhook
ZALO_WEBHOOK_SECRET=CHANGE_ME_GENERATE_URLSAFE_RANDOM
ZALO_BOT_ADMIN_USERNAME=admin
ENABLE_ZALO_ERROR_ALERTS=true
# Leave blank to derive a stable key from SECRET_KEY, or provide a valid Fernet key.
ZALO_STATE_ENCRYPTION_KEY=
ZALO_SEND_RETRY_ATTEMPTS=3
ZALO_SEND_RETRY_BASE_DELAY_SECONDS=0.4
ZALO_SMART_ASSISTANT_V2=true
ZALO_ENABLE_WRITE_ACTIONS=true
ZALO_ENABLE_NOTIFICATIONS=true
ZALO_LINK_CODE_TTL_SECONDS=30
ZALO_PENDING_ACTION_TTL_SECONDS=120
ZALO_EXPORT_LINK_TTL_SECONDS=300
# Browser-safe Mapbox token for the production globe. Public scopes only.
MAPBOX_PUBLIC_TOKEN=

# Enable Nginx IP-ban synchronization after running scripts/configure_nginx_security.py.
# This directory must contain nginx.exe and conf/nginx.conf on Windows.
NGINX_SECURITY_PREFIX=
# Set to 127.0.0.1 behind the local Nginx proxy to prevent direct port-8000 bypass.
BACKEND_HOST=0.0.0.0
